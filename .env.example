# ==========================================
# DISASTERSHIELD — GLOBAL ENVIRONMENT CONFIG
# ==========================================

# --- FRONTEND (disastershield-command) ---
VITE_API_URL=http://localhost:5000/api
VITE_MAPBOX_TOKEN=your-mapbox-token-here

# --- BACKEND (api-server) ---
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/disastershield_e2e
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:8080
DATA_MODE=LIVE

# External AI / GIS Engines
INTELLIGENCE_ENGINE_URL=http://localhost:8000
GIS_ENGINE_URL=http://localhost:8001

# External APIs
IMD_API_KEY=
BHUVAN_API_KEY=
DATA_GOV_API_KEY=

# --- INTELLIGENCE ENGINE ---
# Runs on Port 8000 by default

# --- GIS ENGINE ---
# Runs on Port 8001 by default
